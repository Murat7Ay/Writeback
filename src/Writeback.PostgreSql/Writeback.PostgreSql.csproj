<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Writeback.PostgreSql</PackageId>
    <Description>Binary COPY bulk loading for Writeback entities on PostgreSQL.</Description>
    <PackageTags>dapper;postgresql;npgsql;copy;bulk</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Writeback\Writeback.csproj" />
  </ItemGroup>
</Project>
