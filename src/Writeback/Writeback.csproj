<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Writeback</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Writeback</PackageId>
    <Description>Persistence commands for Dapper: insert, update, delete and get with database-generated values, optimistic concurrency and honest batching across SQL Server, PostgreSQL, MySQL and SQLite.</Description>
    <PackageTags>dapper;sql;crud;insert;update;returning;output;batch;postgresql;sqlserver;mysql;sqlite</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Writeback.Tests" />
    <InternalsVisibleTo Include="Writeback.Benchmarks" />
  </ItemGroup>
</Project>
